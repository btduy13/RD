{
  "name": "rd-accounting",
  "version": "3.3.0",
  "description": "Phần mềm kế toán độc lập Công ty Cổ phần Rạng Đông",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:sync && npm run test:sync-v2 && npm run test:core && npm run test:persistence && npm run test:partners && npm run test:prefs && npm run test:print && npm run test:print-layout && npm run test:print-template && npm run test:voucher-forms && npm run test:products",
    "test:sync": "node tests/sync-regression-tests.js",
    "test:sync-v2": "node tests/sync-v2-regression-tests.js",
    "test:core": "node tests/core-regression-tests.js",
    "test:persistence": "node tests/persistence-regression-tests.js",
    "test:accounting": "node tests/core-regression-tests.js",
    "test:partners": "node tests/partner-merge-tests.js",
    "test:prefs": "node tests/user-preferences-tests.js",
    "test:print": "node tests/print-settings-tests.js",
    "test:print-layout": "node tests/print-layout-tests.js",
    "test:print-template": "node tests/voucher-template-editor-tests.js",
    "test:voucher-forms": "node tests/voucher-form-table-tests.js",
    "test:products": "node tests/product-identity-tests.js",
    "db:dedupe-products": "electron scripts/db-migrate-product-dedupe.js",
    "package-win": "electron-packager . rd-accounting --platform=win32 --arch=x64 --out=dist --overwrite --ignore=dist",
    "build-win": "electron-builder build --win --x64"
  },
  "keywords": [
    "accounting",
    "rangdong",
    "desktop-app"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "build": {
    "appId": "com.rangdong.accounting",
    "productName": "Kế toán Rạng Đông",
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kế toán Rạng Đông",
      "uninstallDisplayName": "Kế toán Rạng Đông",
      "runAfterFinish": true,
      "include": "installer.nsh"
    },
    "files": [
      "index.html",
      "js/**/*.js",
      "data.js",
      "styles.css",
      "main.js",
      "preload.js",
      "logo.jpg",
      "icon.ico",
      "images (1).png",
      "xlsx.full.min.js",
      "prepopulated_database.js",
      "package.json",
      "excel/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ]
  }
}
