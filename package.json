{
  "name": "rd-accounting",
  "version": "1.0.0",
  "description": "Phần mềm kế toán độc lập Công ty Cổ phần Rạng Đông",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package-win": "electron-packager . rd-accounting --platform=win32 --arch=x64 --out=dist --overwrite --ignore=dist",
    "build-win": "electron-builder build --win --x64"
  },
  "keywords": [
    "accounting",
    "rangdong",
    "desktop-app"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "build": {
    "appId": "com.rangdong.accounting",
    "productName": "Kế toán Rạng Đông",
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kế toán Rạng Đông",
      "uninstallDisplayName": "Kế toán Rạng Đông",
      "runAfterFinish": true
    },
    "files": [
      "index.html",
      "app.js",
      "data.js",
      "styles.css",
      "main.js",
      "images (1).png",
      "xlsx.full.min.js",
      "prepopulated_database.js",
      "package.json"
    ]
  }
}
